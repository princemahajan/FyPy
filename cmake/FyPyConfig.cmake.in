# Author: Bharat Mahajan

# - Config file for the FyPy package

# It defines the following variables
#  FYPY_LIBRARIES    - libraries to link against
#  FYPY_EXECUTABLE   - the test executable (python module)

get_filename_component(FYPY_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

# FLINT CMAKE config and target files are in binary dir
@PACKAGE_INIT@

# Our library dependencies (contains definitions for IMPORTED targets)
if(NOT TARGET FyPy AND NOT FYPY_BINARY_DIR)
  include("${FYPY_CMAKE_DIR}/FyPyTargets.cmake")
endif()

# These are IMPORTED targets created by FyPyTargets.cmake
set(FYPY_LIBRARIES FyPy)
set(FYPY_EXECUTABLE TestFyPy)


